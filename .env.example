APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

TRIPJACK_API_KEY=
# "test" (default) uses apitest-hms/apitest-hotel-booker. Set to "production"
# to switch to TripJack's live hosts — do this ONLY after UAT self-certification
# is complete and approved by TripJack's API team. Leave the TRIPJACK_*_BASE_URL
# vars below unset/commented so this switch actually takes effect; only set one
# of them explicitly if you need a one-off override that doesn't fit test/production.
TRIPJACK_ENV=test
# TRIPJACK_HMS_BASE_URL=
# TRIPJACK_BOOKER_BASE_URL=
# TRIPJACK_BOOKER_V1_BASE_URL=
# TRIPJACK_NATIONALITY_BASE_URL=
TRIPJACK_TIMEOUT=30
TRIPJACK_CONNECT_TIMEOUT=5
# Retries use exponential backoff (1s, 2s, 4s...) and honor Retry-After on 429s.
TRIPJACK_RETRY_TIMES=2
TRIPJACK_RETRY_SLEEP_MS=200

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

GOOGLE_MAPS_API_KEY=
